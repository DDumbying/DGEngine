prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: slime
Description: Deterministic real-time 3D particle physics: fluids, sand, cloth, ropes and soft bodies
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lslime
Libs.private: -lm -pthread
